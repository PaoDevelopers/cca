{
	"name": "cca-ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:react": "vite --config vite.config.ts",
		"build": "vite build --config vite.config.ts",
		"check:tsc": "tsc --noEmit -p tsconfig.json",
		"check:eslint": "eslint .",
		"check:prettier": "prettier --check .",
		"fmt": "prettier --write .",
		"check:e2e": "tsc -p e2e/tsconfig.json && node --test --test-concurrency=1 --test-timeout=60000 \".e2e/*.test.js\""
	},
	"dependencies": {
		"@marcbachmann/cel-js": "^8.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"@vitejs/plugin-react": "^5.2.0",
		"eslint": "^9.39.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^15.15.0",
		"playwright-core": "^1.62.1",
		"prettier": "^3.9.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^6.4.3"
	}
}
